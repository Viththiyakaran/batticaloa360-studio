# Development mode is safe and makes no paid or publishing calls.
NEXT_PUBLIC_DEMO_MODE=true

# Supabase (public browser values)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (server-only)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_IMAGE_MODEL=gpt-image-1

# Gemini (server-only; preferred for text generation when configured)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Scheduled jobs and encrypted OAuth token storage
CRON_SECRET=
TOKEN_ENCRYPTION_KEY=

# Future provider integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
TTS_PROVIDER=mock
TTS_API_KEY=
VIDEO_WORKER_URL=
VIDEO_WORKER_SECRET=
